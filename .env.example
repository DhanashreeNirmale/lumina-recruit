# ============================================================
# LUMINA RECRUIT CONFIGURATION
# ============================================================

# 1. Google Gemini API Key
# Sign up at Google AI Studio to get your key.
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Judge0 Sandbox URL
# Local url if self-hosted, or online instance endpoint.
JUDGE0_API_URL=http://localhost:2358

# 3. OnlineCompiler.io Key (Used by legacy code executor)
CODE_EXECUTOR_API_KEY=your_code_executor_key_here
CODE_EXECUTOR_URL=https://api.onlinecompiler.io/api/run-code-sync/

# 4. Debug Mode
DEBUG=False
